# Copy to .env:  cp .env.example .env

# --- LLM (any OpenAI-compatible endpoint; default = local Ollama) ---
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=hufu-qwen
# none | low | medium | high. low: 12/12 agent tasks passed vs 9/12 with none (Phase 2 eval), ~2x slower
LLM_REASONING_EFFORT=low

# --- Chain: local anvil by default ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
EXPLORER_TX_URL=

# Public Anvil development keys (published by Foundry). NEVER use them on a real network.
# Account 0 = owner (the student's key until they register a passkey in the dashboard), Account 1 = agent session key.
# Guardian = a separate test key (trusted contact; can only pause); the deploy script tops up its gas.
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
GUARDIAN_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9da804cc0e5f2

# --- Testnet (Phase 7) ---
# For Ethereum Sepolia, `make testnet-keys` writes fresh keys to .env.testnet (git-ignored); fund the owner
# from a faucet and run commands with HUFU_ENV=testnet. The Guardian key above is a local-only test key.

# --- API / web ---
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
